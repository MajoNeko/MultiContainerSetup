# Name of the database created on first start
MYSQL_DATABASE=wordpress
# Database user WordPress connects with
MYSQL_USER=wpuser
# Password for that user
MYSQL_PASSWORD=change-me-user
# Root password for the MySQL server
MYSQL_ROOT_PASSWORD=change-me-root

# Must match MYSQL_DATABASE
WORDPRESS_DB_NAME=wordpress
# 	Must match MYSQL_USER
WORDPRESS_DB_USER=wpuser
# Must match MYSQL_PASSWORD
WORDPRESS_DB_PASSWORD=change-me-user

WORDPRESS_TABLE_PREFIX=wp_

WORDPRESS_DEBUG=0

# host port
WP_PORT=8080

WORDPRESS_DB_HOST=db:3306